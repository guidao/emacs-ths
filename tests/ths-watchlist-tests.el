;;; ths-watchlist-tests.el --- Watchlist regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'ths)

(ert-deftest ths-watchlist-normalizes-stock-input-and-rejects-invalid-input ()
  (dolist (pair '(("600519" . "sh600519") ("000001" . "sz000001")
                  ("300033" . "sz300033") ("920001" . "bj920001")
                  ("510300" . "sh510300") ("159915" . "sz159915")
                  ("501018" . "sh501018") ("161725" . "sz161725")
                  ("  SH588000 " . "sh588000")
                  ("  SZ000001 " . "sz000001")))
    (should (equal (cdr pair) (ths-watchlist-symbol (car pair)))))
  (dolist (input '("" "123" "600519,000001" "贵州茅台" "sh000001" "sz399001" "xx300033"))
    (should-error (ths-watchlist-symbol input) :type 'user-error)))

(ert-deftest ths-watchlist-add-button-opens-new-stock-and-does-not-duplicate ()
  (ths-test-with-dashboard
    (ths--set ths--state :query "不存在")
    (let ((ths-auto-fetch t) calls)
      (cl-letf (((symbol-function 'ths-data-fetch)
                 (lambda (symbol kind _cb) (push (cons symbol kind) calls) #'ignore))
                ((symbol-function 'ths-search-read)
                 (lambda (&rest _) '(:symbol "sz000001" :name "平安银行"))))
        (ths-test-press 'shortcut-a)
        (ths-add-favorite "sz000001"))
      (should (member '("sz000001" . quote) calls))
      (should (member '("sz000001" . intraday) calls))
      (should (member '("sz000001" . trades) calls)))
    (let ((state (etaf-value ths--state)))
      (should (equal "000001" (plist-get state :selected)))
      (should (eq 'favorites (plist-get state :tab)))
      (should (equal "" (plist-get state :query)))
      (should (= 1 (cl-count "000001" (plist-get state :favorites) :test #'equal)))
      (should (= 9 (length ths-data-stocks))))
    (should (equal "平安银行" (plist-get (ths-data-find "000001") :name)))
    (should (eq #'ths-add-favorite (key-binding (kbd "a"))))
    (should (eq #'ths-remove-favorite (key-binding (kbd "d"))))
    (ths-test-press 'shortcut-d)
    (should-not (member "000001" (plist-get (etaf-value ths--state) :favorites)))
    (should (ths-data-find "000001"))))

(ert-deftest ths-watchlist-invalid-add-and-save-failure-preserve-state ()
  (ths-test-with-dashboard
    (let ((before (copy-tree (etaf-value ths--state))) (stocks (copy-tree ths-data-stocks)))
      (should-error (ths-add-favorite "bad") :type 'user-error)
      (cl-letf (((symbol-function 'ths-watchlist-save) (lambda (_) (user-error "disk full"))))
        (should-error (ths-add-favorite "000001") :type 'user-error)
        (should-error (ths-remove-favorite) :type 'user-error)
        (should-error (ths-toggle-favorite) :type 'user-error))
      (should (equal before (etaf-value ths--state)))
      (should (equal stocks ths-data-stocks)))))

(ert-deftest ths-watchlist-restores-added-symbols-and-persists-empty-list ()
  (let* ((directory (make-temp-file "ths-watchlist-test-" t))
         (ths-watchlist-file (expand-file-name "nested/watchlist.json" directory))
         (ths-auto-fetch nil) (ths-buffer-name " *ths-watchlist-persist*") buffer)
    (unwind-protect
        (progn
          (setq buffer (ths))
          (with-current-buffer buffer (ths-add-favorite "000001"))
          (kill-buffer buffer)
          (setq buffer (ths))
          (with-current-buffer buffer
            (should (equal "sz000001" (plist-get (ths-data-find "000001") :symbol)))
            (should (member "000001" (plist-get (etaf-value ths--state) :favorites)))
            (ths--section 'list)
            (ths-test-press 'favorites)
            (while (plist-get (etaf-value ths--state) :favorites) (ths-remove-favorite))
            (should-not (plist-get (etaf-value ths--state) :selected))
            (should (ths-test-visible "暂无自选")))
          (kill-buffer buffer)
          (setq buffer (ths))
          (with-current-buffer buffer
            (should-not (plist-get (etaf-value ths--state) :favorites))
            (ths-toggle-favorite)
            (should (= 1 (length (ths-watchlist-load))))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory directory t))))

(ert-deftest ths-watchlist-bad-file-is-not-overwritten-or-evaluated ()
  (let* ((directory (make-temp-file "ths-watchlist-test-" t))
         (ths-watchlist-file (expand-file-name "watchlist.json" directory)))
    (unwind-protect
        (progn
          (with-temp-file ths-watchlist-file (insert "(error \"must not evaluate\")"))
          (should-error (ths-watchlist-load) :type 'user-error)
          (with-temp-buffer
            (insert-file-contents ths-watchlist-file)
            (should (equal (buffer-string) "(error \"must not evaluate\")")))
          (let ((ths-watchlist-file directory))
            (should-error (ths-watchlist-save '("sz000001")) :type 'user-error))
          (should-not (directory-files directory nil "\\`\\.ths-watchlist-")))
      (delete-directory directory t))))

(ert-deftest ths-watchlist-funds-persist-and-trigger-quote-chart-trade-requests ()
  (let ((ths-watchlist-file (make-temp-file "ths-fund-watchlist-")))
    (unwind-protect
        (progn
          (ths-watchlist-save '("sh510300" "sz159915" "sh501018" "sz161725"))
          (should (equal (ths-watchlist-load) '("sh510300" "sz159915" "sh501018" "sz161725")))
          (ths-test-empty-dashboard
            (let ((ths-auto-fetch t) calls)
              (cl-letf (((symbol-function 'ths-data-fetch)
                         (lambda (symbol kind _cb)
                           (push (cons symbol kind) calls) #'ignore)))
                (ths-add-favorite "159915" "创业板ETF")
                (ths-test-press 'daily)
                (dolist (kind '(quote intraday daily trades))
                  (should (member (cons "sz159915" kind) calls)))
                (should (ths-data-fund-p (ths-data-find "159915")))
                (should (ths-test-visible "场内基金"))
                (ths-remove-favorite)
                (should-not (member "sz159915" (ths-watchlist-load)))))))
      (delete-file ths-watchlist-file))))

(ert-deftest ths-watchlist-page-is-a-table-and-enter-opens-selected-intraday ()
  (ths-test-with-dashboard
    (dolist (width '(160 80 44))
      (etaf-runtime-refit (etaf-runtime-for-buffer buffer) width 24)
      (ths-daily)
      (ths-show-ranking)
      (ths-test-press 'page-watchlist)
      (should (eq (plist-get (etaf-value ths--state) :page) 'watchlist))
      (dolist (label '("代码" "名称" "最新" "涨跌幅"))
        (should (ths-test-visible label)))
      (dolist (label '("分时走势" "五档盘口" "成交明细"))
        (should-not (ths-test-visible label)))
      (should (<= (count-lines (point-min) (point-max)) 23))
      (ths-next-stock)
      (let* ((state (etaf-value ths--state)) (code (plist-get state :selected))
             (runtime (etaf-runtime-for-buffer buffer)))
        (should (eq (etaf-focused-host-ref runtime) (intern (concat "watch-" code))))
        (call-interactively (key-binding (kbd "RET")))
        (should (eq (plist-get (etaf-value ths--state) :page) 'quotes))
        (should (equal code (plist-get (etaf-value ths--state) :selected)))
        (should (eq (plist-get (etaf-value ths--state) :chart) 'intraday))
        (should (ths-test-visible "分时走势"))))))

(ert-deftest ths-watchlist-table-pagination-and-editing-preserve-selection ()
  (ths-test-with-dashboard
    (setq ths-data-stocks
          (append ths-data-stocks
                  (cl-loop for i from 100 to 130 collect (ths-data-placeholder (format "sz%06d" i)))))
    (ths--set ths--state :favorites (mapcar #'ths-data-id ths-data-stocks))
    (etaf-runtime-refit (etaf-runtime-for-buffer buffer) 80 20)
    (ths-show-watchlist)
    (ths-next-page)
    (should (ths-test-visible "2 / 3"))
    (should-not (ths-test-visible "同花顺"))
    (should (<= (count-lines (point-min) (point-max)) 19))
    (ths-add-favorite "000001" "平安银行")
    (should (eq (plist-get (etaf-value ths--state) :page) 'watchlist))
    (should (ths-test-visible "平安银行"))
    (ths-remove-favorite)
    (should (ths-test-visible (plist-get (etaf-value ths--state) :selected)))
    (ths--set ths--state :favorites nil)
    (should (ths-test-visible "暂无自选"))
    (should-not (plist-get (etaf-value ths--state) :selected))))

(ert-deftest ths-watchlist-navigation-fetches-charts-only-after-opening ()
  (ths-test-with-dashboard
    (let ((ths-auto-fetch t) calls)
      (cl-letf (((symbol-function 'ths-data-fetch)
                 (lambda (symbol kind _callback)
                   (push (cons symbol kind) calls) #'ignore)))
        (ths-show-watchlist)
        (ths-next-stock)
        (should calls)
        (should (cl-every (lambda (call) (eq (cdr call) 'quote)) calls))
        (ths-test-press 'shortcut-RET)
        (should (seq-some (lambda (call) (eq (cdr call) 'intraday)) calls))
        (should (seq-some (lambda (call) (eq (cdr call) 'trades)) calls))))))

(ert-deftest ths-watchlist-shortcuts-and-custom-columns-update-live-table ()
  (ths-test-with-dashboard
    (let ((original (copy-tree ths-watchlist-columns)) configured)
      (unwind-protect
          (progn
            (call-interactively (key-binding (kbd "4")))
            (should (eq (plist-get (etaf-value ths--state) :page) 'watchlist))
            (etaf-runtime-refit (etaf-runtime-for-buffer buffer) 80 24)
            (should (ths-test-visible "成交量"))
            (should (ths-test-visible "流通市值"))
            (cl-letf (((symbol-function 'customize-variable)
                       (lambda (variable &rest _) (setq configured variable))))
              (ths-test-press 'shortcut-C))
            (should (eq configured 'ths-watchlist-columns))
            (setq ths-data-stocks
                  (mapcar (lambda (stock)
                            (append '(:volume 123456 :float-cap 56789000000) stock))
                          ths-data-stocks))
            (customize-set-variable 'ths-watchlist-columns
                                    '((:name "证券" 12) (:volume "总量" 12) (:float-cap "流值" 12)))
            (should (ths-test-visible "证券"))
            (should (ths-test-visible "总量"))
            (should (ths-test-visible "流值"))
            (should (ths-test-visible "12.35万手"))
            (should (ths-test-visible "567.89亿"))
            (should-not (ths-test-visible "涨跌幅"))
            (should (equal (mapcar #'car (ths--watchlist-columns 80)) '(:name :volume :float-cap)))
            (dolist (bad '(nil ((:unknown "未知" 10)) ((:volume "成交量" 0))))
              (should-error (customize-set-variable 'ths-watchlist-columns bad) :type 'user-error))
            (should (equal (mapcar #'car ths-watchlist-columns) '(:name :volume :float-cap))))
        (customize-set-variable 'ths-watchlist-columns original)))))

