(ert-deftest ths-incomplete-intraday-does-not-stretch-to-close ()
  (let* ((stock (ths-data--chart ths-test-tencent-minute "sz300033" 'tencent 'intraday))
         (svg (ths-chart-svg stock)))
    (with-temp-buffer
      (insert svg)
      (let* ((root (car (xml-parse-region (point-min) (point-max))))
             (group (car (xml-get-children root 'g)))
             (circle (car (xml-get-children group 'circle))))
        (should (equal (xml-get-attribute circle 'cx) "212.00"))))
    (should (= 3 (length (ths-data-series stock 241))))
    (should (equal (ths-chart-line nil) "暂无分时数据"))
    (should (equal (ths-chart-candles nil) "暂无日 K 数据"))
    (should-not (ths-chart-svg nil))))

(ert-deftest ths-daily-parsers-use-real-ohlc-and-reject-invalid-data ()
