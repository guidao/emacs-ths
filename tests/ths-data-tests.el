(ert-deftest ths-real-curl-failure-is-reported-and-cleaned-up ()
  (skip-unless (executable-find ths-data-curl-program))
  (let (done result failure cancel)
    (unwind-protect
        (progn
          (setq cancel (ths-data--http "file:///ths-nonexistent-test-directory/quote" 'tencent
                                       (lambda (text err) (setq result text failure err done t))))
          (let ((deadline (+ (float-time) 5)))
            (while (and (not done) (< (float-time) deadline)) (accept-process-output nil 0.05)))
          (should done)
          (should-not result)
          (should (string-match-p "HTTP 请求失败" failure))
          (should-not (seq-find (lambda (b) (string-prefix-p " *ths-http*" (buffer-name b))) (buffer-list))))
      (when cancel (funcall cancel)))))

