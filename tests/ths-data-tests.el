(ert-deftest ths-intraday-parsers-preserve-session-time-and-base ()
  (dolist (quote (list (ths-data--chart ths-test-tencent-minute "sz300033" 'tencent 'intraday)
                       (ths-data--chart ths-test-eastmoney-minute "sz300033" 'eastmoney 'intraday)))
    (should (= (plist-get quote :intraday-close) 168.0))
    (should (equal (plist-get quote :intraday-date) "2026-10-16"))
    (should (= (plist-get (car (plist-get quote :points)) :slot) 0))
    (should (= (plist-get (car (last (plist-get quote :points))) :slot) 60))
    (should (= (car (last (ths-data-series quote))) 173.88)))
  (should (= 120 (ths-data-minute-slot "11:30")))
  (should (= 120 (ths-data-minute-slot "1300")))
  (should (= 240 (ths-data-minute-slot "1500")))
  (should-error (ths-data-minute-slot "09:60"))
  (should-error (ths-data-minute-slot "1200")))

