  (should-error (ths-data--chart "{\"data\":{\"klines\":[\"2026-10-15,170,173,160,169\"]}}"
                                 "sz300033" 'eastmoney 'daily))
  (should-error (ths-data--chart "{\"data\":{}}" "sz300033" 'tencent 'intraday)))

(ert-deftest ths-provider-fallback-after-network-and-parser-failures ()
  (let ((ths-data-providers '(tencent eastmoney sina)) calls result failure)
    (cl-letf (((symbol-function 'ths-data--http)
               (lambda (_url provider callback)
                 (push provider calls)
                 (pcase provider
                   ('tencent (funcall callback nil "timeout"))
                   ('eastmoney (funcall callback "<html>blocked</html>" nil))
                   ('sina (funcall callback ths-test-sina nil)))
                 #'ignore)))
      (ths-data-fetch "sz300033" 'quote (lambda (value err) (setq result value failure err))))
    (should (equal (nreverse calls) '(tencent eastmoney sina)))
    (should-not failure)
    (should (eq (plist-get result :source) 'sina))
    (should (= 173.88 (plist-get result :price)))))

(ert-deftest ths-chart-fallback-skips-sina-and-reports-total-failure ()
  (let ((ths-data-providers '(sina tencent eastmoney)) calls failure)
    (cl-letf (((symbol-function 'ths-data--http)
               (lambda (_url provider callback)
                 (push provider calls) (funcall callback nil "timeout") #'ignore)))
      (ths-data-fetch "sz300033" 'intraday
                      (lambda (value err) (should-not value) (setq failure err))))
    (should (equal (nreverse calls) '(tencent eastmoney)))
    (should (string-match-p "tencent: timeout.*eastmoney: timeout" failure))))

(ert-deftest ths-cancel-request-stops-fallback-and-late-callbacks ()
  (let ((ths-data-providers '(tencent sina)) callback cancelled called)
    (cl-letf (((symbol-function 'ths-data--http)
               (lambda (_url _provider cb) (setq callback cb)
                 (lambda () (setq cancelled t)))))
      (funcall (ths-data-fetch "sz300033" 'quote (lambda (&rest _) (setq called t))))
      (funcall callback nil "late failure"))
    (should cancelled)
    (should-not called)))

(defmacro ths-test-empty-dashboard (&rest body)
  "Run BODY in an isolated dashboard without network or sample prices."
  (declare (indent 0))
  `(let* ((ths-auto-fetch nil) (ths-buffer-name " *ths-network-test*") (buffer (ths)))
     (unwind-protect (with-current-buffer buffer
                       (etaf-runtime-refit (etaf-runtime-for-buffer buffer) 160 60)
                       ,@body)
       (when (buffer-live-p buffer) (kill-buffer buffer)))))

(ert-deftest ths-empty-dashboard-never-displays-synthetic-market-values ()
  (ths-test-empty-dashboard
   (should (string-match-p "暂无图表数据" (buffer-string)))
   (should (string-match-p "暂无盘口数据" (buffer-string)))
   (should-not (string-match-p "173.88\\|3268.52\\|合成\\|演示" (buffer-string)))
   (should-not (cl-some (lambda (s) (plist-get s :price)) ths-data-stocks))))

(ert-deftest ths-refresh-deduplicates-and-keeps-successful-cache-on-failure ()
  (ths-test-empty-dashboard
   (let (calls callbacks)
     (cl-letf (((symbol-function 'ths-data-fetch)
                (lambda (symbol kind callback)
                  (push (cons symbol kind) calls) (push callback callbacks) #'ignore)))
       (ths--fetch "sz300033" 'quote)
       (ths--fetch "sz300033" 'quote)
       (should (= 1 (length calls)))
       (funcall (pop callbacks) '(:price 173.88 :close 168 :name "同花顺" :source tencent :fetched-at 1 :time "2026-10-16 10:30:00") nil)
       (should (= 0 (hash-table-count ths--requests)))
       (should (string-match-p "173.88" (buffer-string)))
       (ths--fetch "sz300033" 'quote)
       (funcall (pop callbacks) nil "network down")
       (should (= 173.88 (plist-get (ths-data-find "300033") :price)))
       (should (equal "network down" (plist-get (ths-data-find "300033") :quote-error)))
       (should (string-match-p "更新失败，保留上次数据" (buffer-string)))))))

(ert-deftest ths-out-of-order-charts-stay-with-the-requested-symbol ()
  (ths-test-empty-dashboard
   (let (callbacks)
     (cl-letf (((symbol-function 'ths-data-fetch)
                (lambda (symbol _kind cb) (push (cons symbol cb) callbacks) #'ignore)))
       (ths--fetch "sz300033" 'intraday)
       (ths--set ths--state :selected "600519")
       (ths--fetch "sh600519" 'intraday)
       (funcall (cdr (assoc "sh600519" callbacks)) '(:points ((:slot 0 :price 1500)) :intraday-date "2026-10-16" :source tencent) nil)
       (funcall (cdr (assoc "sz300033" callbacks)) '(:points ((:slot 0 :price 170)) :intraday-date "2026-10-16" :source tencent) nil)
       (should (equal '(1500) (ths-data-series (ths-data-find "600519"))))
       (should (equal '(170) (ths-data-series (ths-data-find "300033"))))
       (should (equal "600519" (plist-get (etaf-value ths--state) :selected)))))))

(ert-deftest ths-unmount-cancels-timer-requests-and-ignores-late-result ()
  (ths-test-empty-dashboard
   (let (callback cancelled)
     (cl-letf (((symbol-function 'ths-data-fetch)
                (lambda (_symbol _kind cb)
                  (setq callback cb) (lambda () (setq cancelled t)))))
       (ths--fetch "sz300033" 'quote)
       (setq ths--timer (run-at-time 300 nil #'ignore))
       (let ((timer ths--timer))
         (etaf-unmount (etaf-runtime-for-buffer buffer))
         (should-not (memq timer timer-list)))
       (should cancelled)
       (should-not ths--session)
       (funcall callback '(:price 999) nil)
       (should-not (plist-get (ths-data-find "300033") :price))))))

(ert-deftest ths-real-curl-transport-decodes-gb18030-and-cleans-buffers ()
  "Exercise the actual process sentinel using a local file, without network."
  (skip-unless (executable-find ths-data-curl-program))
  (let ((file (make-temp-file "ths-quote-")) done result failure cancel)
    (unwind-protect
        (progn
          (let ((coding-system-for-write 'gb18030))
            (write-region ths-test-tencent nil file nil 'silent))
          (setq cancel (ths-data--http (concat "file://" file) 'tencent
                                       (lambda (text err) (setq result text failure err done t))))
          (let ((deadline (+ (float-time) 5)))
            (while (and (not done) (< (float-time) deadline)) (accept-process-output nil 0.05)))
          (should done)
          (should-not failure)
          (should (equal result ths-test-tencent))
          (should-not (seq-find (lambda (b) (string-prefix-p " *ths-http*" (buffer-name b))) (buffer-list))))
      (when cancel (funcall cancel))
      (delete-file file))))

(ert-deftest ths-synchronous-provider-failure-cancels-the-active-fallback ()
  (let ((ths-data-providers '(tencent sina)) cancelled)
    (cl-letf (((symbol-function 'ths-data--http)
               (lambda (_url provider callback)
                 (when (eq provider 'tencent) (funcall callback nil "failed immediately"))
                 (lambda () (setq cancelled provider)))))
      (funcall (ths-data-fetch "sz300033" 'quote #'ignore)))
    (should (eq cancelled 'sina))))

(ert-deftest ths-startup-fetches-stocks-indices-and-chart-and-owns-one-timer ()
  (let ((ths-auto-fetch t) (ths-refresh-interval 30) (ths-buffer-name " *ths-startup-test*")
        calls buffer)
    (cl-letf (((symbol-function 'ths-data-fetch)
               (lambda (symbol kind callback)
                 (push (cons symbol kind) calls)
                 (funcall callback nil "offline") #'ignore)))
      (unwind-protect
          (progn
            (setq buffer (ths))
            (with-current-buffer buffer
              (should (= 13 (length calls)))
              (should (member '("sh000001" . quote) calls))
              (should (member '("sz300033" . intraday) calls))
              (should (member '("sz300033" . trades) calls))
              (should (timerp ths--timer))
              (should (= 0 (hash-table-count ths--requests)))
              (should (string-match-p "报价失败" (ths--feed-status)))
              (let ((timer ths--timer))
                (should (eq buffer (ths)))
                (should (eq timer ths--timer)))
              (should (= 13 (length calls)))))
        (when (buffer-live-p buffer) (kill-buffer buffer))))))

(ert-deftest ths-remount-does-not-accept-old-session-response ()
